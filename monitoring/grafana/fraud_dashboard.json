{
  "title": "Credit Card Fraud Detection",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "uid": "fraud-mlops",
  "panels": [
    {
      "type": "timeseries",
      "title": "API Request Rate",
      "targets": [
        {
          "expr": "rate(fraud_api_requests_total[1m])",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Prediction Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(fraud_prediction_latency_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "bargauge",
      "title": "Predictions by Class",
      "targets": [
        {
          "expr": "fraud_predictions_total",
          "legendFormat": "class {{predicted_class}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "API Error Rate",
      "targets": [
        {
          "expr": "rate(fraud_api_errors_total[5m])",
          "legendFormat": "{{type}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "type": "stat",
      "title": "Model Loaded",
      "targets": [{ "expr": "fraud_model_loaded", "legendFormat": "ready" }],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 }
    },
    {
      "type": "timeseries",
      "title": "Feature Drift Score",
      "targets": [
        {
          "expr": "fraud_feature_drift_score",
          "legendFormat": "{{feature}}"
        }
      ],
      "gridPos": { "h": 8, "w": 10, "x": 6, "y": 16 }
    },
    {
      "type": "bargauge",
      "title": "Drift Flags",
      "targets": [{ "expr": "fraud_feature_drift_flag", "legendFormat": "{{feature}}" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 }
    }
  ]
}
